import { Result } from 'core/result'

type DbOpenOk = {
  handle: int
  reused: bool
}

type DbQueryOk = {
  rows: array<Object>
}

type DbExecOk = {
  affected_rows: int
}

type DbUnitOk = {
  ok: bool
}

type DbStatsMetric = {
  calls: int
  errors: int
  total_ms: int
  avg_ms: int
}

type DbStatsOk = {
  active_handles: int
  handles_by_driver: Object
  metrics: Object
}

/// docid: phpx/db/open()
